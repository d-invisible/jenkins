# SMTP values for Jenkins Extended E-mail Notification.
# Copy this file to .env for local reference and replace every placeholder.
BREVO_SMTP_SERVER=example-smtp-relay.brevo.com
BREVO_USERNAME_LOGIN=example-user@smtp-brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_KEY_PASSWORD=replace-with-smtp-key
BREVO_API_KEY=replace-with-api-key
